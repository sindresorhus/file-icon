{
	"name": "file-icon",
	"version": "6.0.0",
	"description": "Get the icon of a file or app as a PNG image (macOS)",
	"license": "MIT",
	"repository": "sindresorhus/file-icon",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": {
		"name": "Sindre Sorhus",
		"email": "sindresorhus@gmail.com",
		"url": "https://sindresorhus.com"
	},
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "xo && ava && tsd",
		"build": "swift build --configuration=release --arch arm64 --arch x86_64 && mv .build/apple/Products/Release/file-icon .",
		"prepare": "npm run build"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"file-icon"
	],
	"keywords": [
		"macos",
		"file",
		"icon",
		"app",
		"png",
		"application",
		"icons",
		"path",
		"filepath",
		"bundle",
		"id",
		"image",
		"size",
		"swift",
		"pid",
		"process",
		"id"
	],
	"dependencies": {
		"p-map": "^7.0.3"
	},
	"devDependencies": {
		"ava": "^6.4.1",
		"execa": "^9.6.0",
		"file-type": "^21.0.0",
		"tempy": "^3.1.0",
		"tsd": "^0.33.0",
		"xo": "^1.2.2"
	}
}
